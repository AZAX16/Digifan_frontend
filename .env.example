# Leave empty to use the local Vite proxy and the production Vercel /api rewrite.
# Set only when calling a different API that explicitly allows browser CORS.
VITE_API_BASE_URL=
# Optional target for the local Vite /api proxy.
# If Render is unreachable locally, use https://digifan-frontend.vercel.app
# so development requests use the working production rewrite.
VITE_DEV_API_PROXY_TARGET=

# Set to false when the target should bypass HTTP_PROXY/HTTPS_PROXY.
VITE_DEV_API_PROXY_USE_ENV=true


# Optional: local network proxy used by `npm run dev` to reach Render.
# Keep these empty when your network can reach Render directly.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
